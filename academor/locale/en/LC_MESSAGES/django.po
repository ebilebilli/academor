#: academor/templates/includes/course_payment_contract.html:29
msgid "2. Payment terms"
msgstr "2. Payment terms"

#: academor/templates/includes/course_payment_contract.html:36
msgid "Payment is made in cash or by bank transfer."
msgstr "Payment is made in cash or by bank transfer."

#: academor/templates/includes/course_payment_contract.html:40
