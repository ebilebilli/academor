      "question": "She ___ a new car.",
      "options": [
        "have",
        "has",
        "is",
        "are"
      ],
      "answer": 1,
      "explanation": "'Has' is used with he/she/it."
    },
    {
      "id": 19,
      "topic": "Have / Has",
      "question": "We ___ a big garden.",
      "options": [
        "have",
        "has",
        "is",
        "does"
      ],
      "answer": 0,
      "explanation": "'We' → 'have'."
    },
    {
      "id": 20,
      "topic": "Have / Has (negative)",
      "question": "He ___ a pet.",
      "options": [
        "don't have",
