      ],
      "answer": 1,
      "explanation": "Negative for he/she/it → 'doesn't have'. (Note: 'hasn't got' is also correct but less common in this form.)"
    },
    {
      "id": 21,
      "topic": "Adjectives",
      "question": "That is a ___ car. (big / before noun)",
      "options": [
        "big red",
        "red big",
        "biggish",
        "redly"
      ],
      "answer": 0,
      "explanation": "In English, adjectives come before the noun and opinion comes before colour: 'big red car'."
    },
    {
      "id": 22,
      "topic": "Adjectives",
      "question": "The film is ___.",
      "options": [
        "bored",
        "boring",
        "bore",
        "boringly"
      ],
      "answer": 1,
      "explanation": "'-ing' adjectives describe things/situations. '-ed' describes feelings. 'The film is boring' (the film causes boredom)."
    },
    {
      "id": 23,
      "topic": "Adjectives",
      "question": "I am ___ about the game.",
      "options": [
        "exciting",
        "excited",
        "excite",
        "excitedly"
      ],
      "answer": 1,
      "explanation": "'-ed' adjectives describe how a person feels: 'I am excited'."
    },
    {
