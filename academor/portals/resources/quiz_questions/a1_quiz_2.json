  "questions": [
    {
      "id": 1,
      "topic": "Present Simple",
      "question": "She ___ to school every day.",
      "options": [
        "go",
        "goes",
        "going",
        "goed"
      ],
      "answer": 1,
      "explanation": "He/she/it → add -s or -es. 'Go' → 'goes'."
    },
    {
      "id": 2,
      "topic": "Present Simple",
      "question": "I ___ coffee every morning.",
      "options": [
        "drink",
        "drinks",
        "drinking",
        "drinked"
      ],
      "answer": 0,
      "explanation": "'I' in Present Simple → base form: 'drink'."
    },
    {
      "id": 3,
      "topic": "Present Simple",
      "question": "They ___ football on Sundays.",
      "options": [
        "play",
        "plays",
        "playing",
        "played"
      ],
      "answer": 0,
      "explanation": "'They' → base form: 'play'."
    },
    {
      "id": 4,
      "topic": "Present Simple",
      "question": "He ___ in London.",
      "options": [
        "live",
        "lives",
        "living",
        "lived"
      ],
      "answer": 1,
      "explanation": "'He' → add -s: 'lives'."
    },
    {
      "id": 5,
      "topic": "Present Simple",
      "question": "My dog ___ a lot.",
      "options": [
        "sleep",
        "sleeps",
        "sleeping",
        "slept"
      ],
      "answer": 1,
      "explanation": "'My dog' (= it) → add -s: 'sleeps'."
    },
    {
      "id": 6,
      "topic": "Present Simple (negative)",
      "question": "I ___ like vegetables.",
      "options": [
        "don't",
        "doesn't",
        "not",
        "no"
      ],
      "answer": 0,
      "explanation": "Negative for I/you/we/they → 'don't + verb'."
    },
    {
      "id": 7,
      "topic": "Present Simple (negative)",
      "question": "She ___ eat meat.",
      "options": [
        "don't",
        "doesn't",
        "not",
        "no"
      ],
      "answer": 1,
      "explanation": "Negative for he/she/it → 'doesn't + verb'."
    },
    {
      "id": 8,
      "topic": "Present Simple (question)",
      "question": "___ you speak English?",
      "options": [
        "Do",
        "Does",
        "Are",
        "Is"
      ],
      "answer": 0,
      "explanation": "Question for I/you/we/they → 'Do + subject + verb?'"
    },
    {
      "id": 9,
      "topic": "Present Simple (question)",
      "question": "___ she work here?",
      "options": [
        "Do",
        "Does",
        "Is",
        "Has"
      ],
      "answer": 1,
      "explanation": "Question for he/she/it → 'Does + subject + base verb?'"
    },
    {
      "id": 10,
      "topic": "Present Simple (spelling)",
      "question": "He ___ TV every night. (watch)",
      "options": [
        "watch",
        "watchs",
        "watches",
        "watchies"
      ],
      "answer": 2,
      "explanation": "Verbs ending in -ch → add -es: 'watches'."
    },
    {
      "id": 11,
      "topic": "Plurals",
      "question": "One cat, two ___.",
      "options": [
        "cat",
        "cats",
        "cates",
        "caties"
      ],
      "answer": 1,
      "explanation": "Most nouns → add -s for plural: 'cats'."
    },
    {
      "id": 12,
      "topic": "Plurals",
      "question": "One bus, three ___.",
      "options": [
        "bus",
        "buss",
        "buses",
        "busies"
      ],
      "answer": 2,
      "explanation": "Nouns ending in -s/-ss/-sh/-ch/-x → add -es: 'buses'."
    },
    {
      "id": 13,
      "topic": "Plurals (irregular)",
      "question": "One child, many ___.",
      "options": [
        "childs",
        "childes",
        "children",
        "childrens"
      ],
      "answer": 2,
      "explanation": "'Child' has an irregular plural: 'children'. Never add -s."
    },
    {
      "id": 14,
      "topic": "Plurals (irregular)",
      "question": "One man, two ___.",
      "options": [
        "mans",
        "manes",
        "men",
        "mens"
      ],
      "answer": 2,
      "explanation": "'Man' → irregular plural 'men'. Vowel change, no -s."
    },
    {
      "id": 15,
      "topic": "Plurals (irregular)",
      "question": "One tooth, many ___.",
      "options": [
        "tooths",
        "teeth",
        "teeths",
        "toothes"
      ],
      "answer": 1,
      "explanation": "'Tooth' → irregular plural 'teeth'. Vowel change."
    },
    {
      "id": 16,
      "topic": "Plurals",
      "question": "One city, five ___.",
      "options": [
        "citys",
        "cityes",
        "cities",
        "city's"
      ],
      "answer": 2,
      "explanation": "Nouns ending in consonant + y → change y to i, add -es: 'cities'."
    },
    {
